{
  "name": "mod-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "release": "tsx scripts/release.ts",
    "release:check": "tsx scripts/release.ts --check",
    "dev": "concurrently -k -n api,app \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:api": "tsx watch server/main.ts",
    "dev:ui": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk --aab",
    "smoke": "tsx scripts/smoke.ts",
    "build:worker": "npm run typecheck && vite build --mode worker",
    "worker:types": "wrangler types",
    "worker:dev": "npm run build:worker && wrangler dev --local",
    "worker:check": "npm run build:worker && wrangler deploy --dry-run",
    "worker:deploy": "npm run build:worker && wrangler deploy",
    "worker:verify": "npm run build:worker && wrangler deploy --dry-run --outdir output/worker && node scripts/verify-worker.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@tauri-apps/plugin-sql": "^2.0.0",
    "dotenv": "^17.0.0",
    "fastify": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "miniflare": "^5.20260923.0-alpha",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.140.0"
  }
}

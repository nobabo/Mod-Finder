{
  "name": "mod-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "community:collect": "tsx tooling/scripts/collect-community-titles.ts",
    "community:build": "tsx tooling/scripts/build-community-ranking.ts",
    "community:refresh": "npm run community:collect && npm run community:build",
    "release": "tsx tooling/scripts/release.ts",
    "release:check": "tsx tooling/scripts/release.ts --check",
    "dev": "concurrently -k -n api,app \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:api": "tsx watch src/server/main.ts",
    "dev:ui": "vite --config tooling/config/vite.config.ts --host 0.0.0.0",
    "build": "tsc --noEmit && vite build --config tooling/config/vite.config.ts",
    "start": "tsx src/server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config tooling/config/vitest.config.ts",
    "tauri": "node tooling/scripts/tauri.mjs",
    "desktop:dev": "npm run tauri -- dev",
    "desktop:build": "npm run tauri -- build",
    "android:init": "node tooling/scripts/android.mjs --check",
    "android:dev": "node tooling/scripts/android.mjs :app:installDebug",
    "android:build": "node tooling/scripts/build-native.mjs android",
    "android:check": "node tooling/scripts/android.mjs :app:testDebugUnitTest :app:lintDebug :app:assembleDebug",
    "android:test:device": "node tooling/scripts/android.mjs :app:connectedDebugAndroidTest",
    "smoke": "tsx tooling/scripts/smoke.ts",
    "build:worker": "npm run typecheck && vite build --config tooling/config/vite.config.ts --mode worker",
    "worker:types": "npm run worker -- types src/worker/worker-configuration.d.ts",
    "worker:dev": "npm run build:worker && npm run worker -- dev --local",
    "worker:check": "npm run build:worker && npm run worker -- deploy --dry-run",
    "worker:deploy": "npm run build:worker && npm run worker -- deploy",
    "worker:verify": "npm run build:worker && npm run worker -- deploy --dry-run --outdir ../../output/worker && node tooling/scripts/verify-worker.mjs",
    "worker": "node tooling/scripts/wrangler.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@tauri-apps/plugin-sql": "^2.0.0",
    "dotenv": "^17.0.0",
    "es-hangul": "^2.4.0",
    "fastify": "^5.0.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^0.468.0",
    "pluralize": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "miniflare": "^5.20260923.0-alpha",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.140.0"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mod Finder",
  "version": "0.1.0",
  "identifier": "io.modfinder.app",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../output/web"
  },
  "app": {
    "windows": [{ "title": "Mod Finder", "width": 1360, "height": 900, "minWidth": 390, "minHeight": 600, "backgroundColor": "#101311" }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' ipc: http://ipc.localhost https: http://127.0.0.1:4318; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": { "active": true, "targets": ["nsis"], "category": "Entertainment", "shortDescription": "게임별 모드 통합 검색", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"], "android": { "minSdkVersion": 29 } }
}
